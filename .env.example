ARENA_KEY=ak_live_replace_me
ARENA_BASE_URL=https://stair-ai.com
OPENAI_API_KEY=replace_me
USE_OPENAI=0
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini,gpt-5.4-nano
DRY_RUN=1
TRADE_EDGE_THRESHOLD_PP=6
MAX_TRADE_USDC=1
STRATEGY_MODE=qualification_probability_ladder
ORDER_EXECUTION_MODE=limit
FOK_PRICE_BUFFER_PP=1.0
ORDER_POLL_SECONDS=30
ORDER_POLL_INTERVAL_SECONDS=2
HYBRID_WINNER_WEIGHT=0.90
HYBRID_VALUE_WEIGHT=0.10
HYBRID_MIN_CONFIDENCE=70
HYBRID_MIN_SOURCE_AGREEMENT=2
HYBRID_MIN_WINNER_PROB=0.44
HYBRID_MAX_WINNER_PRICE=0.90
HYBRID_MIN_WINNER_EDGE_PP=-5.0
HYBRID_VALUE_MIN_EDGE_PP=15.0
HYBRID_VALUE_MIN_CONFIDENCE=85
HYBRID_VALUE_MIN_SOURCE_AGREEMENT=3
HYBRID_VALUE_MAX_PRICE=0.20
HYBRID_VALUE_OVERRIDE_RATE=0.10
SUBMIT_LEDGER=0
LEDGER_BATCH_ENDPOINT=/api/v1/arena/ledger/records/batch
LEDGER_VALIDATE_ENDPOINT=/api/v1/arena/ledger/records/validate
VALIDATE_LEDGER=0
REQUIRE_LIVE_CONFIRM=1
